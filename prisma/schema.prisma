  video videoData[]
  audio audioData[]
  document documentData[]
}
model Project {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  slug           String       @unique
  nameEN         String
  nameAR         String
  descriptionAR  String?
  descriptionEN  String?
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sectionId      String       @db.ObjectId
  coverImage     String       // S3 URL   
  purchacable    Boolean
  assetFiles     dataAsset
  color          String?   
  tagsEN         String[]
  tagsAR         String[]
  keywordsEN     String[]
  keywordsAR     String[]
  projectDynamicData projectDynamicData[]
  purchase       Purchase[]
  ownerIds       String[]     @db.ObjectId
  owners         User[]       @relation("ProjectTeam", fields: [ownerIds], references: [id])
  client         User?        @relation("projectClient",fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  clientId       String?      @db.ObjectId
  uploader       User         @relation("ProjectUploader",fields: [uploaderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploaderId     String       @db.ObjectId
  free           Boolean      @default(true)
  private        Int          @default(0) //0 a normal project uploaded from cello , 1 a project from a plan ,2 from a susbended plan 
  comments       Comment[]
  ratings        Rating[]
  votes          Vote[]
  startDate      DateTime? 
  completionDate DateTime?
  difficulty     Difficulty?
  price          Float?
  createdAt  DateTime @default(now())
  subscriptionId String?
  isActive Boolean @default(true)
}

/// A short-lived note saying "this user already started this download".
///
/// Its only job is to stop one intent being charged twice — the user who
/// dismissed the browser's "Save as" dialog, reloaded, double-clicked, or
/// opened a second tab. Before charging, the download route looks for a live
/// note on (userId, projectId) and re-signs against it instead of spending
/// another credit.
///
/// NOT a download history, and deliberately not retained. That a credit was
/// spent is already recorded by `consume` in SubscriptionUsage and
/// UserAggregatedLimit; which project it went to goes to the logs. Keeping this
/// single-purpose is what lets the rows expire themselves.
///
/// Rows are removed by MongoDB via a TTL index on `expiresAt`, which Prisma
/// cannot declare here. `npm run ensure:indexes` creates it and must be run
/// once per environment — without it nothing ever cleans up.
model DownloadGrant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Always present: downloads require an account, so there is no such thing
  /// as a note that can never be looked up again.
  userId    String   @db.ObjectId
  projectId String   @db.ObjectId
  /// Null when nothing was charged (free project, owner, client, staff).
  featureId String?  @db.ObjectId
  charged   Boolean  @default(false)
  createdAt DateTime @default(now())
  /// TTL anchor: MongoDB deletes the row once this passes.
  expiresAt DateTime

  /// The idempotency barrier, not just an index.
  ///
  /// Exactly one row may exist per (user, project), so two simultaneous clicks
  /// race to insert and only one can win — that winner is the request that
  /// charges. Writing the note after `consume` instead left a window where
  /// neither request had written one yet when the other looked, and both
  /// charged. An expired row is recycled in place rather than duplicated.
  @@unique([userId, projectId])
}

enum Difficulty {
  EASY
  MEDIUM
  HART
}

enum DynamicForms {
  SHORTTEXT
  LONGTEXT
  // COLOR
  SELECT
}

type projectData {
  type    DynamicForms
  titleEN String
  titleAR String
  linkTo  String?
}

model Section {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  nameEN       String
  nameAR       String
  descriptionAR String?
  descriptionEN String?
  slug         String     @unique
  service      Service?   @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  serviceId    String?    @db.ObjectId
  projects     Project[]
  projectData  projectData[]        // Service-specific data (scalable JSON object)
  emailToSection       EmailToSection[]
  assetsConfigurations     configAsset
  isActive Boolean @default(true)
}

model Service {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  nameEN               String
  nameAR               String
  slug                 String @unique
  image                String
  secondaryImage       String?
  thirdImage       String?
  aimEN                String
  aimAR                String
  sections             Section[]
  teamMembers          TeamMember[]
  interestedUserIds    String[]  @db.ObjectId 
  interestedUsers      User[]    @relation(fields: [interestedUserIds], references: [id])
  plans      Plan[]  
  isActive Boolean @default(true)
}
model Comment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  content    String
  createdAt  DateTime @default(now())

  type       CommentType @default(OPINION)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.ObjectId

  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String?   @db.ObjectId

  @@unique([userId, type,projectId])
}

enum CommentType {
  PROJECT
  OPINION
}

model Rating {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  value      Int      
  createdAt  DateTime @default(now())

  type       CommentType @default(OPINION)

  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  
  projectId  String?   @db.ObjectId
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, type,projectId])
}

model Vote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime @default(now())
  userId     String   @db.ObjectId
  projectId  String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, projectId]) 
}

model PasswordToken {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  email    String
  token    String
  expires  DateTime

  @@unique([email, token])
}

model VerificationToken {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  email    String
  token    String
  expires  DateTime
  @@unique([email, token])
}

