type Seo {
  titleEN String
  titleAR String
  metaTitleEN    String   
  metaTitleAR    String
  metaDescEN     String   
  metaDescAR     String
  ogImage        String   
  keywordsEN     String[] 
  keywordsAR     String[]
}

model Attribute {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String
  type      String

  titleEN   String?
  titleAR   String?
  valueEN   String?
  valueAR   String?

  sectionId String?  @db.ObjectId
  cardId    String?  @db.ObjectId

  section   SectionsPages? @relation(fields: [sectionId], references: [id])
  card      Card?    @relation(fields: [cardId], references: [id])

  @@unique([sectionId, key])
  @@unique([cardId, key])
}

model Card {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  key           String
  titleEN       String?
  titleAR       String?
  descriptionEN String?
  descriptionAR String?

  sectionId     String   @db.ObjectId
  section       SectionsPages  @relation(fields: [sectionId], references: [id])

  attributes    Attribute[]

  @@unique([sectionId, key])
}

model SectionsPages {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String   @unique  
  titleEN       String?
  titleAR       String?
  descriptionEN String?  
  descriptionAR String?
  attributes    Attribute[]
  cards         Card[]   
  pageId        String?          @db.ObjectId
  page          Page?           @relation(fields: [pageId], references: [id])
}

model Page {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String   @unique 
  titleEN       String?
  titleAR       String?
  descriptionEN String?
  descriptionAR String?
  seo           Seo
  sections      SectionsPages[]
}
type thresholdsValues {
  title String
  value Float
}
model thresholds {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String   @unique 
  thresholdsValues   thresholdsValues[]         
}
model SearchKeyword {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  word  String 
  @@index([word])
}


model AiMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}