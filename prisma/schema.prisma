generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Gender {
  Male
  Female
}

enum ProviderType {
  GOOGLE
  CREDENTIALS
}

type Provider {
  type     ProviderType
  verified DateTime?
}

type conditions {
  age  Int?
  forClient Boolean?
  gender Gender?
}

model Offer {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  nameAR String 
  nameEN String @unique
  code String  @unique
  models String[]
  shortDetailsAR String 
  shortDetailsEN String
  detailsAR String
  detailsEN String
  duration Int
  extended Int? 
  expiresAt DateTime @default(now())
  reActivate Boolean @default(false)
  createdAt DateTime @default(now())
  price Float
  conditions conditions
  offerSubscriptions OfferSubscriber[]
  isActive Boolean @default(true)
}

model role {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nameEN    String
  nameAR    String
  code      String @unique
  detailsEN String?
  lock      Boolean @default(false)
  detailsAR String?
  userIds   String[] @db.ObjectId
  users     User[] @relation(fields: [userIds],references: [id])
  permissionsIds        String[] @db.ObjectId
  permissions           permission[] @relation(fields: [permissionsIds],references: [id])
  isActive  Boolean @default(true)
}

model permission {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  nameEN         String 
  nameAR         String 
  code           String   @unique
  detailsEN      String?
  detailsAR      String?
  roleIds        String[] @db.ObjectId
  roles          role[]   @relation(fields: [roleIds],references: [id])
  userIds        String[] @db.ObjectId
  users          User[]   @relation(fields: [userIds],references: [id])
}

model Feature {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String   @unique
  nameEN        String   
  nameAR        String   
  descriptionEN String?
  descriptionAR String?  
  type          String    @default("consume")   
  aggregatedLimits    UserAggregatedLimit []    
  limits    SubscriptionFeature []   
  planFeatures        PlanFeature []     
  usages              SubscriptionUsage[]  

}
model Plan {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nameEN          String
  nameAR          String
  slug            String   @unique
  descriptionEN   String?
  descriptionAR   String?
  price           Float    @default(0)
  billingInterval String   @default("monthly") 
  isActive        Boolean  @default(true) 
  createdAt       DateTime @default(now()) 
  updatedAt       DateTime @updatedAt
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  serviceId       String   @db.ObjectId    
  offers          OfferOnPlan []   
  planFeatures        PlanFeature []   
  subscriptions   Subscription[]
}
model PlanFeature {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  planId      String   @db.ObjectId 
  featureId   String   @db.ObjectId 
  limit       Int
  isActive    Boolean  @default(true) 
  createdAt   DateTime @default(now()) 

  plan        Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature     Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}
model Subscription {
  id                  String       @id @default(auto())  @map("_id") @db.ObjectId
  userId              String       @db.ObjectId 
  planId              String       @db.ObjectId 
  status              String       @default("active") // active, cancelled, expired, trialing
  startsAt            DateTime  
  paidAmount          Float      
  offerOnPlanId       String?       @db.ObjectId 
  endsAt              DateTime
  createdAt           DateTime      @default(now()) 
  updatedAt           DateTime      @updatedAt
  isActive            Boolean       @default(true) 
  priority            Int           @default(0)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade) // assume User model exists
  plan                Plan          @relation(fields: [planId], references: [id])
  offer               OfferOnPlan?  @relation(fields: [offerOnPlanId], references: [id], onDelete: Cascade)
  
  limits              SubscriptionFeature[]    // usage tracking per feature
  usages              SubscriptionUsage[]     // usage tracking per feature
}
model SubscriptionFeature {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String   @db.ObjectId 
  featureId      String   @db.ObjectId 
  limit          Int
  isActive       Boolean  @default(true) 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt 
  status         String       @default("pending") 
  
  feature       Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  subscription  Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureId])
}
model SubscriptionUsage {
  id             String   @id @default(auto())  @map("_id") @db.ObjectId
  subscriptionId String   @db.ObjectId 
  featureId      String   @db.ObjectId 
  currentUsage   Int      @default(0) 
  createdAt      DateTime @default(now())
  isActive       Boolean  @default(true) 
  updatedAt      DateTime @updatedAt 

  feature       Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  subscription  Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureId])
}

model UserAggregatedLimit {
  id                      String    @id @default(auto())  @map("_id") @db.ObjectId
  userId                  String    @db.ObjectId 
  featureId               String   @db.ObjectId 
  totalLimit              Int       
  projectCount            Int      @default(0)
  subscriptionId          String   @db.ObjectId 
  expireDate              DateTime 
  updatedAt               DateTime  @updatedAt 
  user                    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature                 Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
}


model OfferOnPlan {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  percentageOffer Int          
  offerEndDate    DateTime 
  createdAt       DateTime       @default(now())
  planId          String         @db.ObjectId 
  isActive        Boolean        @default(true) 
  plan            Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[] 
  
}


model sequenceNumber {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  code     String   @unique
  number   Int      @default(0)
}

model User {
  id                    String      @id @default(auto()) @map("_id") @db.ObjectId
  name                  String      @default("user")
  username              String      @unique @default(uuid())
  age                   DateTime?
  gender                Gender?
  email                 String      @unique
  password              String? 
  image                 String?
  phoneNumber           String?
  location              String?
  city                  String?
  jobTitleEN            String?
  jobTitleAR            String?
  detailsEN             String?  
  detailsAR             String?  
  providers             Provider[]
  roleIds               String[]     @db.ObjectId
  roles                 role[]       @relation(fields: [roleIds],references: [id])
  subscriptions         Subscription[]
  aggregatedLimits      UserAggregatedLimit[]

  permissionIds         String[]     @db.ObjectId
  permission            permission[] @relation(fields: [permissionIds],references: [id])
  verifiedClientStatus  Int          @default(0)        //  1 means client request , 2 means client verified , 0 means the default
  interestedServiceIds  String[]     @db.ObjectId
  interestedServices    Service[]    @relation(fields: [interestedServiceIds], references: [id])
  teamMember            TeamMember?  //who make projects .teams of the services
  ownedProjectIds       String[]     @db.ObjectId //the projects that the users uploaded
  ownedProjects         Project[]    @relation("ProjectTeam", fields: [ownedProjectIds], references: [id])
  clientProjects        Project[]    @relation("projectClient")  // Projects where this user is the client
  uploadedProjects      Project[]    @relation("ProjectUploader")
  comments              Comment[]
  ratings               Rating[]
  votes                 Vote[]
  purchase              Purchase[]
  emailToSection        EmailToSection[]
  contactMessages        ContactMessage[]
  sentEmails            EmailToExpert[] @relation("emailSender")
  receivedEmails        EmailToExpert[] @relation("emailExpert")
  verificationRequest   VerificationRequest? @relation("verificationRequest")
  lastLogin             DateTime?
  createdAt             DateTime        @default(now())
  notifications         Notification[]
  offerSubscriptions    OfferSubscriber[]
  investor              Boolean         @default(false)
}

model Purchase{
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  requestedAt     DateTime
  userId          String   
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId       String   
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

}
model OfferSubscriber {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  requestedAt   DateTime
  userId        String     @db.ObjectId
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  status        messageType
  offerId       String     @db.ObjectId
  offer         Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([userId,offerId])
}
enum messageType {
  pending
  in_progress
  resolved
  closed
}
enum NotificationSource {
  emailToExpert
  emailToSection
  OfferSubscriber
  contactMessage
  verificationRequest
  general
}
model ContactMessage {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  EmailedAt     DateTime
  senderId      String       @db.ObjectId
  sender        User         @relation(fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  message       String
 @@index([senderId])
}
model EmailToSection {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  EmailedAt     DateTime
  senderId      String    @db.ObjectId
  sender        User      @relation(fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  status        messageType
  message       String
  sectionId     String     @db.ObjectId
  section       Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([senderId])
}
model EmailToExpert {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  EmailedAt    DateTime
  senderId     String @db.ObjectId
  message      String
  status       messageType
  sender       User   @relation("emailSender", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expertId     String @db.ObjectId  
  expert       User   @relation("emailExpert", fields: [expertId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([senderId, expertId])
}
model VerificationRequest {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  clientId   String      @unique @db.ObjectId  // Add @unique for one-to-one
  client     User        @relation("verificationRequest", fields: [clientId], references: [id], onDelete: Cascade)
  status     messageType
  createdAt  DateTime    @default(now())
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  recipientId    String    @db.ObjectId
  recipient      User      @relation(fields: [recipientId], references: [id])
  source    NotificationSource 
  messageId String?        @db.ObjectId  //link to email to expert or email to section or client notification
  messageEN   String?   
  messageAR   String?                     //if the source is general
  @@index([recipientId])
}
model TeamMember {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  expert     Boolean
  userId     String   @unique @db.ObjectId
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade) 
  serviceId  String  @db.ObjectId
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([userId,serviceId])
}

type projectDynamicData {
  type DynamicForms
  titleEN String
  titleAR String
  valueEN String?
  valueAR String?
}

type imageData {
   url String
}
type videoData{
   url String 
}
type audioData{
   url String 

}
type documentData{
   url String 
}
