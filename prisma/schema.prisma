  PNG
  JPEG
}
enum AudioExtensionsType {
  MP3
  AAC
  WAV
  FLAC
  M4A
  AIFF
  WMA
}
enum DocumentExtensionsType {
  PDF
}
type imageConfig{
   maxNumberOfImages Int 
   maxSizeMb Int
   allowedExtensions ImagesExtensionsType[]
   MinWidth Int
   MaxWidth Int
   MinHight Int
   MaxHight Int
}
type videoConfig{
   maxNumberOfVideos Int 
}
type audioConfig{
   maxNumberOfAudio Int  
   maxSize Int
   allowedExtensions AudioExtensionsType[]
}
type documentConfig{
  maxNumberOfDocs Int
  maxSize Int 
  allowedExtensions DocumentExtensionsType[]
}
type configAsset {
  image imageConfig?
  audio audioConfig?
  video videoConfig?
  document documentConfig?
}
